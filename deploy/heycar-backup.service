[Unit]
Description=CepQontag daily VPS and PostgreSQL backup
After=postgresql.service network.target
ConditionPathIsDirectory=/opt/heycar

[Service]
Type=oneshot
User=root
Group=root
Environment=HEYCAR_ROOT=/opt/heycar
Environment=HEYCAR_DB=heycar_db
Environment=HEYCAR_BACKUP_RETENTION_DAYS=14
ExecStart=/usr/local/sbin/heycar-backup
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=30min
