# Install as a NEW virtual host after a distinct staging DNS name is provisioned.
# Do not replace or edit any production virtual host.
server {
    listen 80;
    server_name ${STAGING_SERVER_NAME};
    location /.well-known/acme-challenge/ { root /var/www/cepqontag-staging-acme; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name ${STAGING_SERVER_NAME};
    ssl_certificate /etc/letsencrypt/live/${STAGING_SERVER_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${STAGING_SERVER_NAME}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 4m;
    location / {
        proxy_pass http://127.0.0.1:8091;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
